<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qi.empsystem.dao.UserMapper">

    <select id="getUserById" resultType="com.qi.empsystem.pojo.User">
        select * from user
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </select>

    <select id="getUserByName" resultType="com.qi.empsystem.pojo.User">
        select * from user
        <where>
            <if test="name != null">
                name = #{name}
            </if>
        </where>
    </select>

    <insert id="addUser" parameterType="com.qi.empsystem.pojo.User">
        insert into user (name,password)
        values (#{name},#{password})
    </insert>

</mapper>