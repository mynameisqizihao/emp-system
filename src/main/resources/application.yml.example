# ============================================================
# application.yml 配置示例
#
# 真正的 application.yml 含有本地数据库密码，已被 .gitignore 忽略，
# 不会提交到仓库。新克隆项目后按下面三步操作：
#
#   1. 复制本文件为 application.yml
#        Windows:  copy src\main\resources\application.yml.example src\main\resources\application.yml
#        macOS/Linux: cp src/main/resources/application.yml.example src/main/resources/application.yml
#
#   2. 把下面的 your_password 改成你本地 MySQL 的密码
#
#   3. 确保本地已创建 empdb 数据库（建表脚本见 src/main/resources/sql/emp_system.sql）
# ============================================================

server:
  port: 8080

spring:
  datasource:
    username: root
    # 改成你本地 MySQL 的密码
    password: your_password
    # serverTimezone 必须和 MySQL 服务器、JVM 的时区一致。
    # 若写成 UTC 而两边都是 UTC+8，date 类型的列写入时会被减 8 小时再截断日期，
    # 存进去直接差一天（如 2026-10-04 存成 2026-10-03）。
    # datetime 列因为读出时会再加 8 小时，正好抵消，所以看不出问题。
    url: jdbc:mysql://localhost:3306/empdb?useSSL=false&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8
    driver-class-name: com.mysql.cj.jdbc.Driver
    type: com.alibaba.druid.pool.DruidDataSource
    # Spring Boot 默认不会注入这些属性值，需要自己绑定
    # Druid 数据源专有配置
    initialSize: 5
    minIdle: 5
    maxActive: 20
    maxWait: 60000
    timeBetweenEvictionRunsMillis: 60000
    minEvictableIdleTimeMillis: 300000
    validationQuery: SELECT 1 FROM DUAL
    testWhileIdle: true
    testOnBorrow: false
    testOnReturn: false
    poolPreparedStatements: true

    # 监控统计拦截的 filters：stat=监控统计、log4j=日志记录、wall=防御 SQL 注入
    filters: stat,wall,log4j
    maxPoolPreparedStatementPerConnectionSize: 20
    useGlobalDataSourceStat: true
    connectionProperties: druid.stat.mergeSql=true;druid.stat.slowSqlMillis=500

  messages:
    basename: i18n.login,i18n.register
  profiles:
    active: dev

mybatis:
  mapper-locations: classpath:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
