<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qi.empsystem.dao.DepartmentMapper">

    <!-- 查询所有部门 -->
    <select id="listDepartments" resultType="com.qi.empsystem.pojo.Department">
        select id,department_name
        from department
        order by id asc
    </select>

    <!-- 按部门名精确查询（重名校验用） -->
    <select id="getByName" resultType="com.qi.empsystem.pojo.Department">
        select id,department_name
        from department
        where department_name = #{departmentName}
        limit 1
    </select>

    <!-- 新增部门 -->
    <insert id="insertDepartment" parameterType="com.qi.empsystem.pojo.Department"
            useGeneratedKeys="true" keyProperty="id">
        insert into department(department_name)
        values (#{departmentName})
    </insert>

    <!-- 修改部门 -->
    <update id="updateDepartment" parameterType="com.qi.empsystem.pojo.Department">
        update department
        set department_name = #{departmentName}
        where id = #{id}
    </update>

    <!-- 删除部门 -->
    <delete id="deleteDepartment">
        delete from department where id = #{id}
    </delete>

    <!-- 删除部门前的校验：department_id 上有外键 fk_department_id，
         部门下还有员工的话直接删会抛数据库异常 -->
    <select id="countEmployeesByDept" resultType="int">
        select count(*) from employee where department_id = #{id}
    </select>

</mapper>
