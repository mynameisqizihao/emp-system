<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qi.empsystem.dao.EmployeeMapper">

    <resultMap id="EmployeeMap" type="com.qi.empsystem.pojo.Employee">
        <id property="id" column="eid"></id>
        <result property="lastName" column="last_name"></result>
        <result property="email" column="email"></result>
        <result property="gender" column="gender"></result>
        <result property="birth" column="birth"></result>
        <association property="department" javaType="com.qi.empsystem.pojo.Department">
            <id property="id" column="did"></id>
            <result property="departmentName" column="department_name"></result>
        </association>
    </resultMap>

    <!-- 查询所有员工（含部门名） -->
    <select id="listEmployees" resultMap="EmployeeMap">
        select e.id eid,
               e.last_name,
               e.email,
               e.gender,
               e.department_id,
               e.birth,
               d.id did,
               d.department_name
        from employee e
        inner join department d
        on e.department_id = d.id
        order by e.id asc
    </select>

    <!-- 根据 id 查询单个员工 -->
    <select id="getEmployeeById" parameterType="Integer" resultMap="EmployeeMap">
        select e.id eid,
               e.last_name,
               e.email,
               e.gender,
               e.department_id,
               e.birth,
               d.id did,
               d.department_name
        from employee e
        inner join department d
        on e.department_id=d.id
        <where>
            <if test="id != null">
                e.id = #{id}
            </if>
        </where>
    </select>

    <!-- 新增员工 -->
    <insert id="insertEmployee" parameterType="com.qi.empsystem.pojo.Employee">
        insert into employee(last_name,email,gender,department_id,birth)
        values (#{lastName},#{email},#{gender},#{department.id},#{birth})
    </insert>

    <!-- 修改员工 -->
    <update id="updateEmployee" parameterType="com.qi.empsystem.pojo.Employee">
        update employee
        <set>
            last_name=#{lastName},
            email=#{email},
            gender=#{gender},
            department_id=#{department.id},
            birth=#{birth}
        </set>
        <where>
            <if test="id != null">
                id = #{id}
            </if>
        </where>
    </update>

    <!-- 删除员工 -->
    <delete id="deleteEmployee" parameterType="Integer">
        delete from employee
        <where>
            <if test="id != null">
                id=#{id}
            </if>
        </where>
    </delete>

    <!-- 统计员工总数（不带搜索条件） -->
    <select id="countEmployees" resultType="int">
        select count(*) from employee
    </select>

    <!-- 分页查询：带关键字搜索（按姓名或邮箱模糊匹配） -->
    <select id="listEmployeesByPage" resultMap="EmployeeMap">
        select e.id eid,
               e.last_name,
               e.email,
               e.gender,
               e.department_id,
               e.birth,
               d.id did,
               d.department_name
        from employee e
        inner join department d
        on e.department_id=d.id
        <where>
            <if test="keyword != null and keyword != ''">
                (e.last_name like concat('%', #{keyword}, '%')
                 or e.email like concat('%', #{keyword}, '%'))
            </if>
        </where>
        order by e.id asc
        limit #{offset},#{size}
    </select>

    <!-- 搜索条件必须和上面的 listEmployeesByPage 完全一致，否则分页总数会算错 -->
    <select id="countEmployeesByKeyword" resultType="int">
        select count(*)
        from employee e
        <where>
            <if test="keyword != null and keyword != ''">
                (e.last_name like concat('%', #{keyword}, '%')
                 or e.email like concat('%', #{keyword}, '%'))
            </if>
        </where>
    </select>
</mapper>
